    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record uses the camera for Face Cam and Monokol MK295 glasses overlay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record использует камеру для записи Face Cam и наложения очков Monokol MK295."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record records microphone audio for your videos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record записывает звук с микрофона для ваших видео."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record saves finished recordings to your photo library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record сохраняет готовые записи в вашу фотогалерею."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record needs library access to export and import recordings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glassy Record нужен доступ к галерее для экспорта и импорта записей."
          }
        }
      }
    }
  },
  "version": "1.0"
